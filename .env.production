NODE_PATH=src
# BASE_PATH например /math_race
VITE_BASE_PATH=/photo_quest
VITE_SHAMAN_ENVIRONMENT=<%SHAMAN_ENVIRONMENT-stage%>
VITE_ENVIRONMENT=production
VITE_CLICK_STREAM_HOST=<%CLICKSTREAM_HOST%>
# Общий пейвол Учи (content-paywall), открывается в iframe, когда закончились бусины
VITE_CONTENT_PAYWALL_URL=<%CONTENT_PAYWALL_URL%>

# Sentry
VITE_SENTRY_ENVIRONMENT=<%SENTRY_ENVIRONMENT-stage%>
VITE_SENTRY_RELEASE=<%SENTRY_RELEASE-off%>


# Бэкенд прогресса: шлюз Учи отдаёт /photo-quest/api/* сервису photo-quest-api и ставит Uchi-User-Id
VITE_PROGRESS_API=/photo_quest/api/v1
