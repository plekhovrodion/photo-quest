NODE_PATH=src
# BASE_PATH например /math_race
VITE_BASE_PATH=/photo_quest
VITE_SHAMAN_ENVIRONMENT=local
VITE_ENVIRONMENT=development
VITE_CLICK_STREAM_HOST=https://events.stage-uchi.ru/

# Sentry
VITE_SENTRY_ENVIRONMENT=local
VITE_SENTRY_RELEASE=off
VITE_SENTRY_AUTH_TOKEN=STUB


# Бэкенд прогресса (photo-quest-backend, make run на :8080); локально ученика задаёт id ниже
VITE_PROGRESS_API=/photo_quest/api/v1
VITE_DEV_USER_ID=1
# Пейвол локально не поднят: адрес пустой, кнопки покупки в окне «Бусины закончились» нет
VITE_CONTENT_PAYWALL_URL=
